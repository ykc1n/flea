{
  "name": "flea",
  "version": "1.0.0",
  "private": true,
  "description": "A Zero-K replay explorer and processing worker",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js && node --check web/app.js",
    "server": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "host": "node dist/src/host.js",
    "demo": "node dist/scripts/demo.js",
    "requeue": "node dist/scripts/requeue.js",
    "backup": "node dist/scripts/backup.js",
    "verify": "node dist/scripts/verify.js",
    "cloud-job": "node dist/scripts/cloud-job.js",
    "benchmark": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "yauzl": "^3.4.0"
  }
}

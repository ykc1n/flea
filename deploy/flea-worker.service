[Unit]
Description=Flea hourly replay discovery and analysis worker
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=flea
WorkingDirectory=/opt/flea
EnvironmentFile=-/etc/flea.env
ExecStart=/usr/bin/node /opt/flea/dist/src/worker.js
Restart=on-failure
RestartSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flea/data
TimeoutStopSec=45
[Install]
WantedBy=multi-user.target

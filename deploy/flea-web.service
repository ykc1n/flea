[Unit]
Description=Flea replay browser
After=network.target
[Service]
Type=simple
User=flea
WorkingDirectory=/opt/flea
EnvironmentFile=-/etc/flea.env
ExecStart=/usr/bin/python3 -m flea.server
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flea/data
[Install]
WantedBy=multi-user.target
